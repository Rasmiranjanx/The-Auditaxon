# Client Environment Configuration
# Copy this file to .env before starting the client development server.

# Base URL of the backend API (including the /api prefix).
# In development, leave as /api to leverage Vite's dev proxy to http://localhost:5000
# In production, set to your backend domain: e.g. https://api.auditaxon.com/api or /api
VITE_API_URL=/api

# Canonical public website URL (no trailing slash)
VITE_SITE_URL=http://localhost:5173
