# Used by `npm run build` (the files uploaded to Hostinger). Public values only, no secrets.
# The backend API runs on Render. To use a custom subdomain later (api.auditaxon.com),
# add it in Render > Settings > Custom Domains, change this line, rebuild and re-upload.
VITE_API_URL=https://auditaxon-api.onrender.com/api
