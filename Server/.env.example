# Server Environment Configuration
# Copy this file to .env and fill in the values before starting the server.

# Runtime environment (development | production | test)
NODE_ENV=development

# Server port (default: 5000)
PORT=5000

# MongoDB connection string (MongoDB Atlas or local)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# JWT secret key for signing tokens (minimum 32 characters recommended)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_at_least_32_characters_long

# JWT token expiration window (e.g. 7d, 24h, 15m)
JWT_EXPIRES_IN=7d

# Frontend client URL (no trailing slash), used for CORS allowlisting and reset password links
CLIENT_URL=http://localhost:5173

# Cloudinary configuration for team photos, cover images, and attachments
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Resend API key for transactional emails
RESEND_API_KEY=re_your_resend_api_key

# Sender email address for outgoing transactional emails
MAIL_FROM=The Auditaxon <onboarding@resend.dev>

# Firm email address to receive incoming contact inquiries, applications, and reviews
ADMIN_NOTIFY_EMAIL=contact@auditaxon.com

# ---- Optional ----
# Extra origins allowed to call the API, comma-separated (CLIENT_URL and its www/apex
# variant are always allowed; localhost:5173 is allowed outside production).
# CORS_ORIGINS=https://staging.auditaxon.com

# Number of reverse proxies in front of the server (Render, Nginx...). Default: 1
# TRUST_PROXY=1
